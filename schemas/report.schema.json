{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/krishanumala/gatekeeper-eos-v6/schemas/report.schema.json",
  "title": "Report Session Output",
  "description": "Schema for outputs produced by a report session during multi-session penetration testing.",
  "type": "object",
  "required": ["session_id", "plan_id", "executive_summary", "findings", "recommendations", "completed_at"],
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^report-\\d{2}$",
      "description": "Session identifier, e.g. report-01"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^PTO-\\d{3}$",
      "description": "Signed plan identifier this session belongs to"
    },
    "executive_summary": {
      "type": "object",
      "required": ["overall_risk", "top_findings", "metrics"],
      "properties": {
        "overall_risk": {
          "type": "string",
          "enum": ["Critical", "High", "Medium", "Low"],
          "description": "Overall risk rating for the assessment"
        },
        "top_findings": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "maxItems": 5,
          "description": "Top 3-5 most critical findings (one sentence each)"
        },
        "metrics": {
          "type": "object",
          "properties": {
            "total_findings": { "type": "integer", "minimum": 0 },
            "critical": { "type": "integer", "minimum": 0 },
            "high": { "type": "integer", "minimum": 0 },
            "medium": { "type": "integer", "minimum": 0 },
            "low": { "type": "integer", "minimum": 0 }
          },
          "required": ["total_findings"]
        },
        "scope": {
          "type": "string",
          "description": "The authorized scope of the assessment"
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "Consolidated technical findings from all sessions",
      "items": {
        "type": "object",
        "required": ["finding_id", "title", "severity", "affected_component", "description", "steps_to_reproduce"],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^PENTEST-\\d{3}$",
            "description": "Unique finding identifier"
          },
          "title": {
            "type": "string",
            "minLength": 5
          },
          "severity": {
            "type": "string",
            "enum": ["Critical", "High", "Medium", "Low", "Info"]
          },
          "affected_component": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 20
          },
          "steps_to_reproduce": {
            "type": "string",
            "minLength": 10
          },
          "technical_impact": {
            "type": "string"
          },
          "cvss_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "source_session": {
            "type": "string",
            "description": "Session that discovered this finding (e.g. scan-01)"
          }
        }
      },
      "minItems": 0
    },
    "recommendations": {
      "type": "object",
      "properties": {
        "short_term": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Immediate fixes (0-7 days)"
        },
        "medium_term": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Near-term improvements (7-30 days)"
        },
        "long_term": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Strategic improvements (30+ days)"
        }
      }
    },
    "methodology": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Phases and techniques used during the assessment"
    },
    "drift_flagged": {
      "type": "boolean",
      "default": false
    },
    "drift_reason": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
