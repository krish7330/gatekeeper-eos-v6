{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/krishanumala/gatekeeper-eos-v6/schemas/campaign.schema.json",
  "title": "Pentest Campaign (Agentic Capable)",
  "description": "Top-level campaign schema coordinating one or more test sessions. Each session may reference a signed test plan or an agentic plan with autonomous reasoning loop. Global drift rules enforce cross-session boundaries.",
  "type": "object",
  "required": ["campaign_id", "sessions", "global_drift_rules"],
  "additionalProperties": false,
  "properties": {
    "campaign_id": {
      "type": "string",
      "pattern": "^CAMP-[a-zA-Z0-9-]+$",
      "description": "Unique identifier for the overall campaign."
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/session"
      }
    },
    "global_drift_rules": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/drift_rule"
      },
      "description": "Drift rules applied across all sessions (can be overridden per session)."
    }
  },
  "definitions": {
    "session": {
      "type": "object",
      "required": ["session_id", "plan", "schedule"],
      "additionalProperties": false,
      "properties": {
        "session_id": {
          "type": "string",
          "pattern": "^SESS-[a-zA-Z0-9-]+$"
        },
        "plan": {
          "oneOf": [
            {
              "$ref": "https://github.com/krishanumala/gatekeeper-eos-v6/schemas/agentic-plan.schema.json",
              "description": "Inline agentic plan with full test plan + agentic_config block"
            },
            {
              "type": "string",
              "pattern": "^PLAN-[a-zA-Z0-9-]+$",
              "description": "Reference to a pre-approved plan by ID (fetch from plan repository)"
            }
          ]
        },
        "schedule": {
          "$ref": "#/definitions/schedule"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^SESS-[a-zA-Z0-9-]+$"
          },
          "description": "Session IDs that must complete successfully before this one starts."
        },
        "max_parallel_actions": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Number of atomic actions within this session that can run concurrently."
        },
        "drift_rules_override": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/drift_rule"
          },
          "description": "Session-specific drift rules that override the global ones."
        }
      }
    },
    "schedule": {
      "type": "object",
      "required": ["start_at"],
      "additionalProperties": false,
      "properties": {
        "start_at": {
          "type": "string",
          "format": "date-time",
          "description": "Earliest time this session can start."
        },
        "deadline": {
          "type": "string",
          "format": "date-time",
          "description": "If set, the session will be aborted if it hasn't finished by this time."
        },
        "max_duration": {
          "type": "string",
          "format": "duration",
          "description": "Maximum wall-clock time the session is allowed to run (ISO 8601 duration)."
        }
      }
    },
    "drift_rule": {
      "type": "object",
      "required": ["id", "description", "condition", "action"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "DRIFT-TARGET",
            "DRIFT-TOOLS",
            "DRIFT-NET",
            "DRIFT-SCHEMA",
            "DRIFT-PLAN",
            "DRIFT-EXPIRY",
            "DRIFT-AGENT-STATE"
          ],
          "description": "Unique identifier for the drift rule."
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of what the rule detects."
        },
        "condition": {
          "type": "string",
          "description": "Machine-readable condition expression."
        },
        "action": {
          "type": "string",
          "enum": ["HALT", "LOG_ONLY"],
          "default": "HALT",
          "description": "Action to take when the rule triggers. HALT stops the session, LOG_ONLY records the violation."
        }
      }
    },
    "finding_summary": {
      "type": "object",
      "description": "Summary of a single security finding discovered by an agentic session.",
      "properties": {
        "title": {
          "type": "string",
          "description": "Short description of the finding."
        },
        "severity": {
          "type": "string",
          "enum": ["info", "low", "medium", "high", "critical"],
          "description": "Risk level of the finding."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence score from 0 (speculative) to 1 (confirmed)."
        },
        "cve": {
          "type": "string",
          "pattern": "^CVE-\\d{4}-\\d{4,}$",
          "description": "Optional CVE identifier."
        },
        "remediation": {
          "type": "string",
          "description": "Optional recommended fix or mitigation step."
        }
      },
      "required": ["title", "severity"],
      "additionalProperties": false
    },
    "stop_condition": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["finding_severity", "success_criterion_met", "max_steps", "time_limit"],
          "description": "Type of stop condition."
        },
        "value": {
          "type": "string",
          "description": "Parameter for the condition. For finding_severity: severity level. For time_limit: ISO 8601 duration. For max_steps: integer as string. For success_criterion_met: not used."
        }
      }
    }
  }
}
