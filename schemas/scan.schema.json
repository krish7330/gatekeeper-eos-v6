{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/krishanumala/gatekeeper-eos-v6/schemas/scan.schema.json",
  "title": "Vulnerability Scan Session Output",
  "description": "Schema for outputs produced by a scan session during multi-session penetration testing.",
  "type": "object",
  "required": ["session_id", "plan_id", "vulnerabilities", "completed_at"],
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^scan-\\d{2}$",
      "description": "Session identifier, e.g. scan-01"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^PTO-\\d{3}$",
      "description": "Signed plan identifier this session belongs to"
    },
    "vulnerabilities": {
      "type": "array",
      "description": "List of discovered vulnerabilities",
      "items": {
        "type": "object",
        "required": ["id", "title", "severity", "affected_component", "description"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CVE-\\d{4}-\\d{4,}$|^OWASP-\\w+|^VULN-\\d{3}$",
            "description": "Vulnerability identifier (CVE, OWASP category, or internal ID)"
          },
          "title": {
            "type": "string",
            "minLength": 5,
            "description": "Descriptive title of the vulnerability"
          },
          "severity": {
            "type": "string",
            "enum": ["Critical", "High", "Medium", "Low", "Info"],
            "description": "Severity rating"
          },
          "affected_component": {
            "type": "string",
            "description": "The specific component, endpoint, or service affected"
          },
          "description": {
            "type": "string",
            "minLength": 20,
            "description": "Detailed description of the vulnerability"
          },
          "likelihood": {
            "type": "string",
            "enum": ["High", "Medium", "Low"],
            "description": "Likelihood of exploitation"
          },
          "impact": {
            "type": "string",
            "enum": ["Critical", "High", "Medium", "Low"],
            "description": "Business impact if exploited"
          },
          "cvss_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 10,
            "description": "CVSS v3 score if applicable"
          },
          "proof_of_concept": {
            "type": "string",
            "description": "Brief proof-of-concept if details allow"
          },
          "remediation": {
            "type": "string",
            "description": "Suggested remediation steps"
          }
        }
      },
      "minItems": 0
    },
    "summary": {
      "type": "object",
      "properties": {
        "total_vulnerabilities": { "type": "integer", "minimum": 0 },
        "critical": { "type": "integer", "minimum": 0 },
        "high": { "type": "integer", "minimum": 0 },
        "medium": { "type": "integer", "minimum": 0 },
        "low": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 }
      },
      "required": ["total_vulnerabilities"]
    },
    "drift_flagged": {
      "type": "boolean",
      "default": false
    },
    "drift_reason": {
      "type": "string"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "target_scope": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
