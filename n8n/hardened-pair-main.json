      {
        "parameters": {
          "jsCode": "// Generate a deterministic idempotency key from the input.\n// Re-run detection: same input → same key → skip duplicate processing.\n\nconst crypto = typeof require !== 'undefined' ? require('crypto') : null;\n\nconst input = JSON.stringify(items[0].json);\nconst hash = crypto\n  ? crypto.createHash('sha256').update(input).digest('hex').slice(0, 16)\n  : 'key_' + Date.now().toString(36);\n\nreturn items.map(item => ({\n  json: {\n    ...item.json,\n    idempotency_key: hash,\n    received_at: new Date().toISOString()\n  }\n}));"
        },
        "id": "d4e5f6a7-8b9c-4d0e-1f2a-3b4c5d6e7f8a",
        "name": "Generate Idempotency Key",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [850, 300]
      },
      {
        "parameters": {
          "operation": "read",
          "documentId": {
            "__rl": true,
            "mode": "id",
            "value": "YOUR_GOOGLE_SHEET_ID"
          },
          "sheetName": {
            "__rl": true,
            "mode": "list",
            "value": "MESSAGE_LEDGER"
          },
          "options": {
            "dataLocationOnSheet": {
              "range": ""
            }
          }
        },
        "id": "e5f6a7b8-9c0d-4e1f-2a3b-4c5d6e7f8a9b",
        "name": "Read MESSAGE_LEDGER",
        "type": "n8n-nodes-base.googleSheets",
