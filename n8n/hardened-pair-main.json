      },
      {
        "parameters": {
          "jsCode": "// ── Core Processing Logic ──────────────────────────────────\n// Replace this block with your actual business logic.\n// The input is available in items[0].json.\n//\n// Example: proxy the input to an external API, transform data,\n// run an AI model, etc.\n\nreturn items.map(item => ({\n  json: {\n    ...item.json,\n    status: 'processed',\n    output: `Received on ${item.json.received_at}. ` +\n      `Environment: ${item.json.environment || 'unknown'}. ` +\n      `Idempotency key: ${item.json.idempotency_key}.`\n  }\n}));"
        },
        "id": "a7b8c9d0-1e2f-4a3b-4c5d-6e7f8a9b0c1d",
