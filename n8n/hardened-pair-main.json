            "conditions": [
              {
                "id": "f6a7b8c9-0d1e-4f2a-3b4c-5d6e7f8a9b0c",
                "leftValue": "={{ $items('Read MESSAGE_LEDGER').any(item => item.json.message_id === $json.idempotency_key) }}",
                "rightValue": true,
                "operator": {
                  "type": "boolean",
                  "operation": "equals",
                  "name": "filter.operator.equals"
                }
              }
            ],
