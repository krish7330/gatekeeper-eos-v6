"""
{{ system.name }} - {{ system.description | trim }}
Pattern: Agents as Tools (LangGraph)
"""

from typing import TypedDict, Annotated, Sequence, Literal
from operator import add
import os

from langgraph.graph import StateGraph, START, END
from langgraph.graph.message import add_messages
from langchain_core.messages import BaseMessage, HumanMessage
from langchain_openai import ChatOpenAI
from langchain_core.prompts import ChatPromptTemplate


# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------
class AgentState(TypedDict):
    messages: Annotated[Sequence[BaseMessage], add_messages]
    next_agent: str


{% for agent in system.agents[1:] %}
def {{ agent.name }}_node(state: AgentState) -> dict:
    """{{ agent.instructions | trim }}"""
    llm = ChatOpenAI(model="{{ system.model }}")
    prompt = ChatPromptTemplate.from_messages([
        ("system", """{{ agent.instructions | trim }}"""),
        ("messages", "{messages}"),
    ])
    chain = prompt | llm
    result = chain.invoke(state)
    return {"messages": [result]}

{% endfor %}


# ---------------------------------------------------------------------------
# Orchestrator node
# ---------------------------------------------------------------------------
{% set member_names = system.agents[1:] | map(attribute='name') | list %}
members = [{{ member_names | map('tojson') | join(', ') }}]
options = Literal[{{ (member_names + ['FINISH']) | map('tojson') | join(', ') }}]


class RouteResponse(TypedDict):
    next: options


def {{ system.agents[0].name }}_node(state: AgentState):
    """{{ system.agents[0].instructions | trim }}"""
    llm = ChatOpenAI(model="{{ system.model }}")
    prompt = ChatPromptTemplate.from_messages([
        ("system", """{{ system.agents[0].instructions | trim }}

Available tools: {tools}"""),
        ("messages", "{messages}"),
    ]).partial(tools=", ".join(members))

    chain = prompt | llm.with_structured_output(RouteResponse)
    response = chain.invoke(state)
    return {"next_agent": response["next"]}


# ---------------------------------------------------------------------------
# Graph
# ---------------------------------------------------------------------------
builder = StateGraph(AgentState)

builder.add_node("{{ system.agents[0].name }}", {{ system.agents[0].name }}_node)
{% for agent in system.agents[1:] %}
builder.add_node("{{ agent.name }}", {{ agent.name }}_node)
{% endfor %}

builder.add_edge(START, "{{ system.agents[0].name }}")

builder.add_conditional_edges(
    "{{ system.agents[0].name }}",
    lambda state: state["next_agent"],
    {name: name for name in members} | {"FINISH": END},
)

{% for agent in system.agents[1:] %}
builder.add_edge("{{ agent.name }}", "{{ system.agents[0].name }}")
{% endfor %}

graph = builder.compile()


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
def main() -> None:
    user_input = os.environ.get("USER_INPUT", {{ system.example_input | default("") | tojson }})
    print(f"User: {user_input}\n")

    result = graph.invoke({"messages": [HumanMessage(content=user_input)], "next_agent": ""})
    for msg in result["messages"]:
        if hasattr(msg, "content") and msg.content:
            print(f"{msg.type}: {msg.content}")


if __name__ == "__main__":
    main()
