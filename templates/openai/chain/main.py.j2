"""
{{ system.name }} - {{ system.description | trim }}
Pattern: Chain (OpenAI Agents SDK)
"""

import asyncio
import os
from agents import Agent, Runner


# ---------------------------------------------------------------------------
# Agents (linear chain)
# ---------------------------------------------------------------------------
{% for agent in system.agents %}
{{ agent.name }}_agent = Agent(
    name="{{ agent.name | replace('_', ' ') | title }}",
    instructions="""{{ agent.instructions | trim }}""",
)

{% endfor %}

async def main() -> None:
    """Run the chain pipeline — each agent passes its output to the next."""
    user_input = os.environ.get("USER_INPUT", "{{ system.example_input }}")
    print(f"User: {user_input}\n")

    # Linear chain: agent 1 → agent 2 → ... → agent N
    {% for agent in system.agents %}
    {% if loop.first %}
    result = await Runner.run({{ agent.name }}_agent, user_input)
    {% else %}
    result = await Runner.run({{ agent.name }}_agent, result.final_output)
    {% endif %}
    {% endfor %}

    print(f"\nFinal response: {result.final_output}")


if __name__ == "__main__":
    asyncio.run(main())
