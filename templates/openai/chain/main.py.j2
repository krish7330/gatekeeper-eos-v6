"""
{{ system.name }} - {{ system.description | trim }}
Pattern: Chain (OpenAI Agents SDK)
"""

import asyncio
import os
from openai import AsyncOpenAI


# Read OPENAI_BASE_URL and OPENAI_MODEL from env (defaults: https://api.openai.com/v1, gpt-4o-mini)
openai_base_url = os.environ.get("OPENAI_BASE_URL", "https://api.openai.com/v1")
openai_model = os.environ.get("OPENAI_MODEL", "gpt-4o-mini")

# Create async def call_agent(system_prompt, user_message) -> str helper using client.chat.completions.create
async def call_agent(system_prompt, user_message):
    client = AsyncOpenAI(api_key=os.environ.get("OPENAI_API_KEY"), base_url=openai_base_url)
        response = await client.chat.completions.create(
            model=openai_model,
            messages=[{"role": "system", "content": system_prompt}, {"role": "user", "content": user_message}],
        )
        return response.choices[0].message.content

# Store agents as a list of dicts with name and instructions keys from Jinja2 loop
AGENTS = [
{% for agent in system.agents %}
    {"name": "{{ agent.name | replace('_', ' ') | title }}", "instructions": """{{ agent.instructions | trim }}"""},
{% endfor %}
]

async def main() -> None:
    """Run the chain pipeline — each agent passes its output to the next."""
    user_input = os.environ.get("USER_INPUT", "{{ system.example_input }}")
    print(f"User: {user_input}\n")

    # Linear chain: agent 1 → agent 2 → ... → agent N
    output = user_input
    for agent in agents:
        system_prompt = f"{agent['name']}: {agent['instructions']}"
        output = await call_agent(system_prompt, output)
        print(f"\n{agent['name']}: {output}")

    print(f"\nFinal response: {output}")


if __name__ == "__main__":
    asyncio.run(main())
