"""
{{ system.name }} - {{ system.description | trim }}
Pattern: Supervisor Workers (OpenAI Agents SDK)
"""

import asyncio
import os
from agents import Agent, Runner


# ---------------------------------------------------------------------------
# Worker agents
# ---------------------------------------------------------------------------
{% for agent in system.agents[1:] %}
{{ agent.name }}_agent = Agent(
    name="{{ agent.name | replace('_', ' ') | title }}",
    instructions="""{{ agent.instructions | trim }}""",
)
{% endfor %}

# Supervisor orchestrates workers as tools
{{ system.agents[0].name }}_agent = Agent(
    name="{{ system.agents[0].name | replace('_', ' ') | title }}",
    instructions="""{{ system.agents[0].instructions | trim }}

Available workers:
{% for agent in system.agents[1:] %}- {{ agent.name | replace('_', ' ') }}: Call this worker for {{ agent.name | replace('_', ' ') }} tasks.
{% endfor %}""",
    tools=[
        {% for agent in system.agents[1:] %}
        {{ agent.name }}_agent.as_tool(
            tool_name="{{ agent.name }}",
            tool_description="Delegate {{ agent.name | replace('_', ' ') }} tasks to this worker.",
        ),
        {% endfor %}
    ],
)


async def main() -> None:
    """Run the supervisor-workers workflow."""
    user_input = os.environ.get("USER_INPUT", "{{ system.example_input }}")
    print(f"User: {user_input}\n")

    result = await Runner.run({{ system.agents[0].name }}_agent, user_input)
    print(f"\nResponse: {result.final_output}")


if __name__ == "__main__":
    asyncio.run(main())
