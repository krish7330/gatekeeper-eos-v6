"""
{{ system.name }} - {{ system.description | trim }}
Pattern: Broadcast / Mesh (OpenAI Agents SDK)
"""

import asyncio
import os
from agents import Agent, Runner


# ---------------------------------------------------------------------------
# Specialist agents (run in parallel)
# ---------------------------------------------------------------------------
{% for agent in system.agents %}
{{ agent.name }}_agent = Agent(
    name="{{ agent.name | replace('_', ' ') | title }}",
    instructions="""{{ agent.instructions | trim }}""",
)

{% endfor %}


async def main() -> None:
    """Broadcast input to all agents in parallel and merge their responses."""
    user_input = os.environ.get("USER_INPUT", {{ system.example_input | default("") | tojson }})
    print(f"User: {user_input}\n")

    # Fan-out: run all agents concurrently with the same input
    agents = [
        {% for agent in system.agents %}
        {{ agent.name }}_agent,
        {% endfor %}
    ]

    results = await asyncio.gather(*[
        Runner.run(agent, user_input)
        for agent in agents
    ])

    # Display individual responses
    print("=" * 60)
    print("  PARALLEL RESPONSES")
    print("=" * 60)
    {% for agent in system.agents %}
    print(f"\n--- {{ agent.name | replace('_', ' ') | title }} ---")
    print(results[{{ loop.index0 }}].final_output)
    {% endfor %}

    # Combined summary
    print("\n" + "=" * 60)
    print("  COMBINED SUMMARY")
    print("=" * 60)
    print(f"\nReceived {len(results)} responses from {len(agents)} agents:")
    for i, result in enumerate(results):
        agent_name = agents[i].name
        preview = result.final_output[:120].replace("\n", " ")
        print(f"  • {agent_name}: {preview}...")


if __name__ == "__main__":
    asyncio.run(main())
